<section class="tab tonight {{tabs.tonight.cssClass}}" data-tab="tonight" data-group="primary">
  <div class="tonight-body">
    {{#if model.empty}}
      <p class="empty">{{localize "PF2E-D20.Tonight.NoRolls"}}</p>
    {{else}}
      <div class="party band-{{model.party.band}}">
        <div class="party-title">{{localize "PF2E-D20.Tonight.Party"}} — {{sessionLabel}}</div>
        <p class="party-sentence">{{model.partySentence}}</p>
        <div class="party-stats">
          <span>{{localize "PF2E-D20.Tonight.High"}} <b>{{model.party.highPct}}</b></span>
          <span>{{localize "PF2E-D20.Tonight.Nat20"}} <b>{{model.party.nat20Text}}</b></span>
          <span>{{localize "PF2E-D20.Tonight.Nat1"}} <b>{{model.party.nat1Text}}</b></span>
          {{#if model.party.meter}}
            <span class="meter-wrap" title="{{model.party.luckTitle}}">
              <span class="luck-meter"><span class="fill {{model.party.meter.side}}" style="left: {{model.party.meter.left}}%; width: {{model.party.meter.width}}%"></span><span class="tick"></span></span>
            </span>
          {{/if}}
        </div>
      </div>

      <table class="leaderboard">
        <thead>
          <tr>
            <th></th>
            <th class="who"></th>
            <th title="{{localize "PF2E-D20.Tonight.RollsHint"}}">{{localize "PF2E-D20.Tonight.Rolls"}}</th>
            <th title="{{localize "PF2E-D20.Tonight.AverageHint"}}">{{localize "PF2E-D20.Tonight.Average"}}</th>
            <th title="{{localize "PF2E-D20.Tonight.HighHint"}}">{{localize "PF2E-D20.Tonight.High"}}</th>
            <th title="{{localize "PF2E-D20.Tonight.NatHint"}}">{{localize "PF2E-D20.Tonight.Nat20"}}</th>
            <th title="{{localize "PF2E-D20.Tonight.NatHint"}}">{{localize "PF2E-D20.Tonight.Nat1"}}</th>
            <th class="luck-col" title="{{localize "PF2E-D20.Tonight.LuckHint"}}">{{localize "PF2E-D20.Tonight.Luck"}}</th>
          </tr>
        </thead>
        <tbody>
          {{#each model.rows}}
            <tr class="row band-{{this.band}} {{#if this.thin}}thin{{/if}} {{#if this.none}}none{{/if}}">
              <td><button type="button" class="icon plain" data-action="toggleExpand" data-id="{{this.id}}"><i class="fa-solid {{#if this.expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}"></i></button></td>
              <td class="who"><b>{{this.label}}</b>{{#if this.subtitle}}<small>{{this.subtitle}}</small>{{/if}}</td>
              <td>{{this.luck.n}}</td>
              <td>{{this.average}} <small>{{this.averageDelta}}</small></td>
              <td>{{this.highPct}}</td>
              <td>{{this.nat20Text}}</td>
              <td>{{this.nat1Text}}</td>
              <td class="luck-col" title="{{this.luckTitle}}">
                {{#if this.meter}}
                  <span class="luck-meter"><span class="fill {{this.meter.side}}" style="left: {{this.meter.left}}%; width: {{this.meter.width}}%"></span><span class="tick"></span></span>
                  <b class="luck-pct">{{this.luckText}}</b> <em>{{this.bandLabel}}</em>
                {{else}}
                  <small>{{this.luckText}}</small>
                {{/if}}
              </td>
            </tr>
            {{#if this.expanded}}
              <tr class="detail">
                <td colspan="8">
                  {{> "modules/pf2e-d20-session-tracker/templates/tracker/partials/histogram.hbs" bars=this.histBars}}
                  <div class="detail-numbers">
                    {{#each this.details}}<span class="kvchip"><small>{{this.label}}</small> <b>{{this.value}}</b></span>{{/each}}
                  </div>
                  <div class="types">
                    {{#each this.types}}<span class="chip">{{this.type}} <b>{{this.n}}</b></span>{{/each}}
                    {{#if this.rerolls}}<span class="chip">rerolls <b>{{this.rerolls}}</b></span>{{/if}}
                    {{#if this.secret}}<span class="chip">secret <b>{{this.secret}}</b></span>{{/if}}
                  </div>
                </td>
              </tr>
            {{/if}}
          {{/each}}
        </tbody>
      </table>
    {{/if}}
    <p class="help"><i class="fa-solid fa-circle-info"></i> {{localize "PF2E-D20.Tonight.Help"}}</p>
  </div>
</section>
