<section class="tab history {{tabs.history.cssClass}}" data-tab="history" data-group="primary">
  <div class="history-body">
    {{#if history.empty}}
      <p class="empty">{{localize "PF2E-D20.History.Empty"}}</p>
    {{else}}
      <div class="party band-{{history.party.band}}">
        <div class="party-title">{{localize "PF2E-D20.History.AllTime"}} — {{history.party.evenings}} {{localize "PF2E-D20.History.Evenings"}}</div>
        <div class="party-stats">
          <span><b>{{history.party.allTime.n}}</b> {{localize "PF2E-D20.Tonight.Dice"}}</span>
          <span>{{localize "PF2E-D20.Tonight.Mean"}} <b>{{d20fixed history.party.allTime.mean 2}}</b></span>
          <span>{{localize "PF2E-D20.Tonight.Z"}} <b>{{d20signed history.party.allTime.z 2}}</b> <em>{{history.party.bandLabel}}</em></span>
          {{#if history.party.best}}<span>{{localize "PF2E-D20.History.Best"}} <b>{{history.party.best.key}}</b> ({{d20signed history.party.best.z 2}})</span>{{/if}}
          {{#if history.party.worst}}<span>{{localize "PF2E-D20.History.Worst"}} <b>{{history.party.worst.key}}</b> ({{d20signed history.party.worst.z 2}})</span>{{/if}}
        </div>
      </div>

      <table class="leaderboard history-rank">
        <thead><tr><th class="who">{{localize "PF2E-D20.History.Rank"}}</th><th>{{localize "PF2E-D20.History.Evenings"}}</th><th>n</th><th>{{localize "PF2E-D20.Tonight.Mean"}}</th><th>{{localize "PF2E-D20.Tonight.Z"}}</th><th>{{localize "PF2E-D20.History.Nat20Rate"}}</th><th>{{localize "PF2E-D20.History.Best"}}</th><th>{{localize "PF2E-D20.History.Worst"}}</th><th class="spark-col">{{localize "PF2E-D20.History.Trend"}}</th></tr></thead>
        <tbody>
          {{#each history.groups}}
            <tr class="row band-{{this.band}} {{#if this.thin}}thin{{/if}}">
              <td class="who"><b>{{this.label}}</b></td>
              <td>{{this.evenings}}</td>
              <td>{{this.allTime.n}}</td>
              <td>{{d20fixed this.allTime.mean 2}}</td>
              <td class="z">{{#if this.none}}–{{else}}{{d20signed this.allTime.z 2}} <em>{{this.bandLabel}}</em>{{/if}}</td>
              <td>{{this.nat20RateLabel}}</td>
              <td>{{#if this.best}}{{this.best.key}} <small>{{d20signed this.best.z 1}}</small>{{else}}–{{/if}}</td>
              <td>{{#if this.worst}}{{this.worst.key}} <small>{{d20signed this.worst.z 1}}</small>{{else}}–{{/if}}</td>
              <td class="spark-col"><div class="spark">{{#each this.spark}}<span class="{{this.cls}}" style="height: {{this.h}}%" title="{{this.key}}: z {{this.z}} (n {{this.n}})"></span>{{/each}}</div></td>
            </tr>
          {{/each}}
        </tbody>
      </table>

      <table class="leaderboard history-grid">
        <thead><tr><th class="who">{{localize "PF2E-D20.Controls.Session"}}</th><th>n</th><th>{{localize "PF2E-D20.Tonight.Party"}}</th>{{#each history.groups}}<th>{{this.label}}</th>{{/each}}</tr></thead>
        <tbody>
          {{#each history.sessions}}
            <tr>
              <td class="who"><b>{{this.label}}</b></td>
              <td>{{this.n}}</td>
              <td class="z band-{{this.party.band}}">{{d20signed this.party.z 2}}</td>
              {{#each this.cellList}}<td class="z band-{{this.band}} {{#if this.thin}}thin{{/if}}">{{#if this.present}}{{#if this.none}}– <small>{{this.n}}</small>{{else}}{{d20signed this.z 2}} <small>{{this.n}}</small>{{/if}}{{else}}–{{/if}}</td>{{/each}}
            </tr>
          {{/each}}
        </tbody>
      </table>
    {{/if}}
    <p class="help"><i class="fa-solid fa-circle-info"></i> {{localize "PF2E-D20.History.Help"}}</p>
  </div>
</section>
