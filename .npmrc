# Supply-chain policy for this repository (docs/PLAN.md D11). Dev tooling only: nothing from npm ships in the module.
# No package may run code at install time. Both dev dependencies work without install scripts.
ignore-scripts=true
# New dependencies are recorded as exact versions; upgrades are deliberate edits, never range drift.
save-exact=true
# Cooldown: a version must have been public for two weeks before npm will resolve to it, which is
# longer than hijacked releases have stayed up so far. (Verified on npm 11.19, which ships with
# Node 24; npm 9 does not know the setting. `npm ci` installs what the lockfile says either way.)
min-release-age=14
# Only the public registry, always over TLS, and the lockfile is always written and honoured.
registry=https://registry.npmjs.org/
strict-ssl=true
package-lock=true
audit=true
fund=false
update-notifier=false
